[sub_resource type="GDScript" id="GDScript_53g1x"]
script/source = "extends Node2D

@export var tiempo_visible: float = 7.0
@export var tiempo_oculto: float = 15.0

func _ready():
	iniciar_bucle_electricidad()
		
func iniciar_bucle_electricidad():
	while true:
		visible = true
		reproducir_animaciones(true)
		
		await get_tree().create_timer(tiempo_visible).timeout
		
		visible = false
		reproducir_animaciones(false)
		
		await get_tree().create_timer(tiempo_oculto).timeout

func reproducir_animaciones(activar: bool):
	for casilla in get_children():
		if casilla.has_node(\"AnimatedSprite2D\"):
			var sprite = casilla.get_node(\"AnimatedSprite2D\")
			if activar:
				sprite.play()
			else:
				sprite.stop()
"

